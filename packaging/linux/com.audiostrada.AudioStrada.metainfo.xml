<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.audiostrada.AudioStrada</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>AudioStrada</name>
  <summary>Record, edit and mix music</summary>
  <developer id="com.audiostrada">
    <name>David Jean Louis</name>
  </developer>
  <url type="homepage">https://audiostrada.com</url>
  <url type="bugtracker">https://github.com/audiostrada/audiostrada/issues</url>
  <url type="help">https://audiostrada.com/manual/</url>
  <url type="vcs-browser">https://github.com/audiostrada/audiostrada</url>
  <description>
    <p>
      AudioStrada is a digital audio workstation: multitrack recording and editing, a mixing
      console with buses and VCAs, automation, CLAP, VST3 and LV2 plugins running in their own
      processes, MIDI instruments with a piano roll, built-in effects including a Neural Amp
      Modeler amp, time stretching, and export to WAV, FLAC and MP3.
    </p>
    <p>
      On Linux it plays through PipeWire with no configuration, and also supports JACK and
      ALSA.
    </p>
    <p>
      This official build runs in evaluation mode, muting the sound briefly from time to time,
      until a license bought on audiostrada.com is installed.
    </p>
  </description>
  <launchable type="desktop-id">audiostrada.desktop</launchable>
  <categories>
    <category>AudioVideo</category>
    <category>Audio</category>
  </categories>
  <provides>
    <binary>audiostrada</binary>
    <mediatype>application/x-audiostrada-project</mediatype>
  </provides>
